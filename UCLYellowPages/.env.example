# Copy this file to .env (same folder) and fill it in. .env is ignored by git.

# Gmail account that sends verification codes, and a 16-character app password for it
# (Google Account > Security > 2-Step Verification > App passwords).
EMAIL_HOST_USER=your.address@gmail.com
EMAIL_HOST_PASSWORD=

# Optional
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=
